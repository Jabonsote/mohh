#!/bin/bash
#
# Servidor vLLM persistente para LLaMEA en ixachi (particion gpu).
#
# El modelo queda cargado en la GPU y sirviendo la API OpenAI-compatible
# (/v1) hasta el time limit; la busqueda LLaMEA se conecta a este nodo.
#
# Envio:
#   sbatch slurm/llamea-vllm-server.slrm                 # perfil big-quant (32B AWQ)
#   PROFILE=h100-fp16 sbatch --constraint=H100 slurm/llamea-vllm-server.slrm
#
# El modelo por defecto lo elige slurm/llamea-gpu-profile.sh (32B AWQ, el mayor
# que cabe en cualquier GPU). Para correr la busqueda completa usa mejor el job
# unico: `bash slurm/llamea-all.sh`.
#
# Requisitos (una sola vez, en el login): slurm/ixachi-setup-env.sh con
# WITH_VLLM=1, para que .conda-env tenga vLLM. El script carga el modulo y el
# env igual que los jobs de GE.
#
# Opciones por entorno (todas opcionales):
#   PROFILE=big-quant             perfil GPU/modelo (llamea-gpu-profile.sh)
#   MODEL=org/modelo              override del modelo
#   PORT=8000                     puerto del servidor
#   GPU_MEM_UTIL=0.9              --gpu-memory-utilization (bajar si hay OOM)
#   MAX_MODEL_LEN=16384           --max-model-len
#   TENSOR_PARALLEL=1             --tensor-parallel-size (varias GPUs)
#   EXTRA_VLLM_ARGS="..."         argumentos extra para vllm
#   GPU_SAMPLE_SECONDS=30         periodo del sampler nvidia-smi -> CSV
#   GPU_CSV=...                   ruta del CSV (default results/llamea-gpu-<jobid>.csv)
#
# Los pesos se descargan/verifican en la raiz persistente (LUSTRE/$SCRATCH),
# no en $HOME: `python scripts/mohh_models.py root` la muestra.
#
# Al arrancar imprime el nodo asignado; usalo como LLAMEA_SERVER_HOST.
#
#SBATCH -J llamea-vllm
#SBATCH -p gpu
#SBATCH -N 1
#SBATCH -c 24
#SBATCH --gres=gpu:1
#SBATCH --constraint="A100|H100"
#SBATCH --time=30-00:00:00
#SBATCH -o llamea-vllm-%j.out
#SBATCH -e llamea-vllm-%j.err

cd "$SLURM_SUBMIT_DIR"

source slurm/llamea-gpu-profile.sh
PORT="${PORT:-8000}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.9}"
TENSOR_PARALLEL="${TENSOR_PARALLEL:-1}"

echo "Nodo GPU: $SLURM_JOB_NODELIST"
echo "JobID:    $SLURM_JOB_ID"
echo "Modelo:   $MODEL"
echo "Puerto:   $PORT"
echo "vLLM:     ${VLLM_ARGS:-} ${EXTRA_VLLM_ARGS:-}"

export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

module load python/miniforge
eval "$(conda shell.bash hook)"
conda activate "$SLURM_SUBMIT_DIR/.conda-env"

# Artefactos bajo results/ (incluye el CSV del sampler de GPU).
mkdir -p results

# 0. Raiz persistente de pesos (LUSTRE/$SCRATCH; nunca $HOME).
MODEL_ROOT="$(python scripts/mohh_models.py root)"
export HF_HOME="$MODEL_ROOT"
export HUGGINGFACE_HUB_CACHE="$MODEL_ROOT/hub"
echo "Raiz de modelos: $MODEL_ROOT"

# 1. Modelo en la raiz persistente. El job GPU NUNCA descarga: los nodos de
#    computo no tienen internet y no se debe gastar una asignacion de cola en
#    un fallo de red. El camino normal (`slurm/llamea-all.sh`) ya lo baja en el
#    login; para el servidor persistente se baja una vez con:
#      python scripts/mohh_models.py download "$MODEL"
if ! python scripts/mohh_models.py verify "$MODEL" >/dev/null 2>&1; then
    echo "ERROR: '$MODEL' no esta en la raiz persistente." >&2
    echo "       En el login: python scripts/mohh_models.py download '$MODEL'" >&2
    echo "       O usa el job unico: PROFILE=$PROFILE bash slurm/llamea-all.sh" >&2
    exit 1
fi
echo "Modelo presente y verificado: $MODEL"
# vLLM carga desde la RUTA local del layout persistente, no desde el id de HF.
MODEL_PATH="$(python scripts/mohh_models.py path "$MODEL")"
if [ ! -f "$MODEL_PATH/config.json" ]; then
    echo "ERROR: no se encontro el modelo en $MODEL_PATH" >&2
    exit 1
fi
echo "Pesos locales: $MODEL_PATH"

# 1b. Procedencia: version de vLLM (el resultado depende de ella).
python -c "import vllm; print('vLLM', vllm.__version__)" || echo "AVISO: vllm no importable."

# 2. Sampler de GPU -> CSV, en segundo plano: utilidad real y energia por
#    muestra, ademas de las metricas Prometheus que recoge la busqueda.
GPU_CSV="${GPU_CSV:-results/llamea-gpu-${SLURM_JOB_ID}.csv}"
GPU_SAMPLE_SECONDS="${GPU_SAMPLE_SECONDS:-30}"
GPU_SAMPLER_PID=""
if command -v nvidia-smi >/dev/null 2>&1; then
    (
        echo "timestamp,index,name,utilization_gpu_pct,memory_used_mib,memory_total_mib,power_draw_w,temperature_c"
        while true; do
            nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total,power.draw,temperature.gpu \
                --format=csv,noheader,nounits 2>/dev/null || true
            sleep "$GPU_SAMPLE_SECONDS"
        done
    ) > "$GPU_CSV" &
    GPU_SAMPLER_PID=$!
    echo "Sampler GPU: $GPU_CSV (cada ${GPU_SAMPLE_SECONDS}s, pid $GPU_SAMPLER_PID)"
else
    echo "AVISO: nvidia-smi no disponible; sin sampler de GPU."
fi

cleanup() {
    [ -n "$GPU_SAMPLER_PID" ] && kill "$GPU_SAMPLER_PID" 2>/dev/null || true
}
trap cleanup EXIT TERM INT

# 2. Servir. --served-model-name = MODEL para que el cliente use el mismo ID.
MAXLEN_ARG=""
if [ -n "${MAX_MODEL_LEN:-}" ]; then
    MAXLEN_ARG="--max-model-len $MAX_MODEL_LEN"
fi

echo "Para conectarse desde node:"
echo "   LLAMEA_SERVER_HOST=$SLURM_JOB_NODELIST LLAMEA_SERVER_JOBID=$SLURM_JOB_ID \\"
echo "       sbatch slurm/llamea-generate.slrm"
echo "o directamente:"
echo "   python -m mohh.llamea.run --model $MODEL --base-url http://$SLURM_JOB_NODELIST:$PORT/v1"

# 3. Servir. --served-model-name = MODEL para que el cliente use el mismo ID.
#    Se lanza en segundo plano (no `exec`) para que el trap EXIT mate al
#    sampler de GPU al terminar; el job entero vive en el cgroup de SLURM.
python -m vllm.entrypoints.openai.api_server \
    --model "$MODEL_PATH" \
    --served-model-name "$MODEL" \
    --host 0.0.0.0 \
    --port "$PORT" \
    --gpu-memory-utilization "$GPU_MEM_UTIL" \
    --tensor-parallel-size "$TENSOR_PARALLEL" \
    $MAXLEN_ARG \
    ${VLLM_ARGS:-} ${EXTRA_VLLM_ARGS:-} &
VLLM_PID=$!
wait "$VLLM_PID"

