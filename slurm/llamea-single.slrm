#!/bin/bash
#
# UN SOLO JOB: servidor vLLM + busqueda LLaMEA en el mismo nodo GPU.
#
# Es el camino recomendado para la busqueda: el cliente no es CPU-bound (el
# cuello es la inferencia) y asi no hay que coordinar dos jobs ni esperar a que
# arranque el servidor en otro nodo. El modelo se sirve en 127.0.0.1 y la
# busqueda se conecta a localhost; al terminar, el trap apaga el servidor.
#
# Uso recomendado (login, un solo comando; descarga y envia):
#     bash slurm/llamea-all.sh
#     PROFILE=h100-fp16 GENERATIONS=1000 EVAL_TEST=1 bash slurm/llamea-all.sh
#
# Uso directo (el modelo ya debe estar en la raiz persistente):
#     MODEL=Qwen/Qwen2.5-Coder-32B-Instruct-AWQ sbatch slurm/llamea-single.slrm
#     PROFILE=h100-fp16 sbatch --constraint=H100 slurm/llamea-single.slrm
#
# Opciones por entorno: GENERATIONS (1000), NPARENTS (5), NOFFSPRING (2),
# BUDGET (derivado: generaciones x hijos + padres = 2005), SOLVER,
# TRAIN_INSTANCES, TEST_INSTANCES, MO_GENERATIONS, MO_POPULATION_SIZE,
# TEMPERATURE (0.7), TOP_P (0.8), TOP_K (20), SAMPLING_REPETITION_PENALTY (1.05),
# MAX_TOKENS (4096), THINKING (auto; on/off fuerza enable_thinking),
# OPERATOR_MEMORY (12), SEED, EVAL_TEST=1, EVAL_REPEATS (11),
# MUTATION=1, COMMA=1, REFINE_ONLY=1, NO_SAVE_FRONTS=1, REPEAT_PENALTY (0.5),
# DIVERSITY_FEEDBACK (1), PATIENCE (0), STALL_TIMEOUT (3600),
# PARENT_SELECTION (tournament), NICHING (none), COMBINE (1; 0 = solo
# refine/redesign), BEHAVIORAL_PARENTS (1), NOVELTY_WEIGHT (0.5),
# TARGET_PENALTY (1.0), REQUIRE_TARGET_FAMILY (0), EXPERIMENT_NAME, CATEGORY,
# PORT, PROFILE, MODEL, GPU_MEM_UTIL, MAX_MODEL_LEN, TENSOR_PARALLEL,
# VLLM_ARGS (del perfil), EXTRA_VLLM_ARGS (override), EXTRA.
# El job pide 16 CPUs (no 24): el cuello es la GPU y el MOEA interno es
# secuencial; 4 hilos OpenMP bastan para vLLM/tokenizacion.
# 5 padres / 2 hijos: poblacion suficientemente diversa (una familia
# conductual por padre) sin disparar el numero de llamadas al LLM.
# COMPARE=1 agrega, en el mismo job, la comparacion pareada del mejor operador
# contra los clasicos de 1 y 2 hijos (COMPARE_SPLIT=test, COMPARE_REPEATS=11,
# COMPARE_FAIL_POLICY=zero, COMPARE_NAME). COMPARE_GE_PROTOCOL=1 usa el protocolo
# GE completo (3 solvers x 2 mutaciones x 300/105); COMPARE_SOLVERS,
# COMPARE_MUTATION, COMPARE_MUTATION_BOTH y COMPARE_MO_* ajustan el protocolo
# corto.
#
# El entorno (module + .conda-env con vLLM) lo prepara slurm/ixachi-setup-env.sh
# con WITH_VLLM=1, la primera vez, en el login.
#
#SBATCH -J llamea-single
#SBATCH -p gpu
#SBATCH -N 1
#SBATCH -c 16
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH --constraint="A100|H100"
#SBATCH --time=3-00:00:00
#SBATCH -o llamea-single-%j.out
#SBATCH -e llamea-single-%j.err

set -euo pipefail

cd "$SLURM_SUBMIT_DIR"

# Modelo y limites segun el perfil de GPU (override con MODEL/GPU_MEM_UTIL/...).
source slurm/llamea-gpu-profile.sh
PORT="${PORT:-8000}"

echo "Nodo:           $SLURM_JOB_NODELIST"
echo "Perfil:         $PROFILE"
echo "Modelo:         $MODEL"
echo "Constraint:     $CONSTRAINT"
echo "max-model-len:  $MAX_MODEL_LEN   gpu-mem-util: $GPU_MEM_UTIL"
echo "vLLM args:      ${VLLM_ARGS:-} ${EXTRA_VLLM_ARGS:-}"

# vLLM usa unos pocos hilos para tokenizacion/planificacion; el MOEA interno es
# pymoo/numpy secuencial, asi que no escala con 16 nucleos. Se deja un hilo
# BLAS para no sobre-suscribir y 4 hilos OpenMP para vLLM.
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

module load python/miniforge
eval "$(conda shell.bash hook)"
conda activate "$SLURM_SUBMIT_DIR/.conda-env"

mkdir -p results
MODEL_ROOT="$(python scripts/mohh_models.py root | head -1)"
# vLLM y huggingface no deben escribir nada en $HOME (se borra y no lo ven los
# nodos de computo): todo el cache va a la raiz persistente.
export HF_HOME="$MODEL_ROOT"
export HUGGINGFACE_HUB_CACHE="$MODEL_ROOT/hub"
echo "Raiz de modelos: $MODEL_ROOT"

# 1. Modelo: debe estar ya en la raiz persistente. Los nodos de computo no
#    tienen internet, asi que aqui NO se descarga: se falla rapido y se le dice
#    al usuario que use el comando unico del login, que baja el modelo y envia
#    este mismo job. Asi nunca se queda un job ocupando cola para fallar en red.
if ! python scripts/mohh_models.py verify "$MODEL" >/dev/null 2>&1; then
    echo "ERROR: '$MODEL' no esta en la raiz persistente." >&2
    echo "       En el login, un solo comando (baja el modelo y envia el job):" >&2
    echo "         PROFILE=$PROFILE bash slurm/llamea-all.sh" >&2
    exit 1
fi
# vLLM necesita la RUTA local (los pesos viven en <raiz>/<org>--<modelo>, no en
# el cache de HF). El nombre servido sigue siendo el ID para el cliente.
MODEL_PATH="$(python scripts/mohh_models.py path "$MODEL")"
if [ ! -f "$MODEL_PATH/config.json" ]; then
    echo "ERROR: no se encontro el modelo en $MODEL_PATH" >&2
    echo "         PROFILE=$PROFILE bash slurm/llamea-all.sh   # en el login" >&2
    exit 1
fi
echo "Pesos locales:  $MODEL_PATH"
python -c "import vllm; print('vLLM', vllm.__version__)" || true

# 2. Servidor vLLM en 127.0.0.1 (solo este job lo usa) + sampler de GPU a CSV.
GPU_CSV="${GPU_CSV:-results/llamea-single-gpu-${SLURM_JOB_ID}.csv}"
SAMPLER_PID=""
if command -v nvidia-smi >/dev/null 2>&1; then
    (
        echo "timestamp,index,name,utilization_gpu_pct,memory_used_mib,memory_total_mib,power_draw_w,temperature_c"
        while true; do
            nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total,power.draw,temperature.gpu \
                --format=csv,noheader,nounits 2>/dev/null || true
            sleep 30
        done
    ) > "$GPU_CSV" &
    SAMPLER_PID=$!
    echo "Sampler GPU: $GPU_CSV (pid $SAMPLER_PID)"
fi

# Parametros de servidor para el patron real de LLaMEA: una peticion cada vez,
# prompts que comparten el mismo preambulo (prefix caching) y logs de peticion
# innecesarios porque los prompts completos ya se guardan en prompts/.
# `VLLM_ARGS` sigue aportando cuantizacion/KV cache por perfil y `EXTRA_VLLM_ARGS`
# permite sobrescribir. `max-num-seqs=4` deja margen para reintentos sin reservar
# recursos para una concurrencia que la busqueda no usa.
#
# vLLM 0.32 elimino `--disable-log-requests` y lo reemplazo por
# `--no-enable-log-requests`. Detectamos el flag que acepta la instalacion para
# no romper versiones antiguas ni futuras.
VLLM_HELP="$(python -m vllm.entrypoints.openai.api_server --help 2>&1 || true)"
VLLM_LOG_ARG=""
if grep -q -- "--no-enable-log-requests" <<<"$VLLM_HELP"; then
    VLLM_LOG_ARG="--no-enable-log-requests"
elif grep -q -- "--disable-log-requests" <<<"$VLLM_HELP"; then
    VLLM_LOG_ARG="--disable-log-requests"
fi
VLLM_COMMON_ARGS=(
    --max-num-seqs 4
    --enable-prefix-caching
)
if [ -n "$VLLM_LOG_ARG" ]; then
    VLLM_COMMON_ARGS+=("$VLLM_LOG_ARG")
fi

python -m vllm.entrypoints.openai.api_server \
    --model "$MODEL_PATH" \
    --served-model-name "$MODEL" \
    --host 127.0.0.1 \
    --port "$PORT" \
    --gpu-memory-utilization "$GPU_MEM_UTIL" \
    --max-model-len "$MAX_MODEL_LEN" \
    --tensor-parallel-size "${TENSOR_PARALLEL:-1}" \
    "${VLLM_COMMON_ARGS[@]}" \
    ${VLLM_ARGS:-} ${EXTRA_VLLM_ARGS:-} &
VLLM_PID=$!

cleanup() {
    kill "$VLLM_PID" 2>/dev/null || true
    [ -n "$SAMPLER_PID" ] && kill "$SAMPLER_PID" 2>/dev/null || true
}
trap cleanup EXIT TERM INT

# 3. Busqueda LLaMEA contra el servidor local (espera a que cargue el modelo).
# 5 padres / 2 hijos: el presupuesto se deriva para que GENERATIONS=1000 sea
# realmente 1000 iteraciones, no 1000 evaluaciones (cada iteracion evalua 2).
GENERATIONS="${GENERATIONS:-1000}"
NPARENTS="${NPARENTS:-5}"
NOFFSPRING="${NOFFSPRING:-2}"
BUDGET="${BUDGET:-$((GENERATIONS * NOFFSPRING + NPARENTS))}"
COMBINE="${COMBINE:-1}"
# `REFINE_ONLY` busca solo refinamiento; el combine de dos padres no aplica.
if [ "${REFINE_ONLY:-0}" = "1" ]; then
    COMBINE=0
fi

ARGS=(
    --model "$MODEL"
    --base-url "http://127.0.0.1:${PORT}/v1"
    --no-download
    --wait-server
    --server-timeout "${SERVER_TIMEOUT:-1800}"
    --budget "$BUDGET"
    --n-parents "$NPARENTS"
    --n-offspring "$NOFFSPRING"
    --max-workers "${MAX_WORKERS:-1}"
    --temperature "${TEMPERATURE:-0.7}"
    --top-p "${TOP_P:-0.8}"
    --top-k "${TOP_K:-20}"
    --sampling-repetition-penalty "${SAMPLING_REPETITION_PENALTY:-1.05}"
    --thinking "${THINKING:-auto}"
    --max-tokens "${MAX_TOKENS:-4096}"
    --operator-memory "${OPERATOR_MEMORY:-12}"
    --repeat-penalty "${REPEAT_PENALTY:-0.5}"
    --patience "${PATIENCE:-0}"
    --stall-timeout "${STALL_TIMEOUT:-3600}"
    --parent-selection "${PARENT_SELECTION:-tournament}"
    --niching "${NICHING:-none}"
    --eval-repeats "${EVAL_REPEATS:-11}"
    --solver "${SOLVER:-MOEAD}"
    --train-instances "${TRAIN_INSTANCES:-8}"
    --mo-generations "${MO_GENERATIONS:-30}"
    --mo-population-size "${MO_POPULATION_SIZE:-30}"
    --instance-timeout "${INSTANCE_TIMEOUT:-300}"
    --seed "${SEED:-42}"
    --reference-operators "${REFERENCE_OPERATORS:-ox,pbx,pmx,cx,erx}"
    --results-dir "results/${CATEGORY:-searches}"
    --experiment-name "${EXPERIMENT_NAME:-LLaMEA_single}"
)
if [ "${EVAL_TEST:-0}" = "1" ]; then
    ARGS+=(--eval-test --test-instances "${TEST_INSTANCES:-8}")
fi
if [ "${MUTATION:-0}" = "1" ]; then
    ARGS+=(--mutation)
fi
if [ "${COMMA:-0}" = "1" ]; then
    ARGS+=(--comma)
fi
if [ "${REFINE_ONLY:-0}" = "1" ]; then
    ARGS+=(--refine-only)
fi
if [ "${NO_SAVE_FRONTS:-0}" = "1" ]; then
    ARGS+=(--no-save-fronts)
fi
if [ "${DIVERSITY_FEEDBACK:-1}" = "0" ]; then
    ARGS+=(--no-diversity-feedback)
fi
if [ "$COMBINE" = "1" ]; then
    ARGS+=(--combine)
    if [ "${BEHAVIORAL_PARENTS:-1}" = "0" ]; then
        ARGS+=(--no-behavioral-parent-selection)
    fi
    ARGS+=(--novelty-weight "${NOVELTY_WEIGHT:-0.5}")
    ARGS+=(--target-penalty "${TARGET_PENALTY:-1.0}")
    if [ "${REQUIRE_TARGET_FAMILY:-0}" = "1" ]; then
        ARGS+=(--require-target-family)
    fi
fi
if [ -n "${EXTRA:-}" ]; then
    # shellcheck disable=SC2206
    ARGS+=(${EXTRA})
fi

python -m mohh.llamea.run "${ARGS[@]}"

# 4. (Opcional) Comparacion pareada contra los clasicos, en el MISMO job.
#    COMPARE=1 la activa; usa el mejor operador que acaba de escribir la busqueda.
if [ "${COMPARE:-0}" = "1" ]; then
    EXP_DIR="results/${CATEGORY:-searches}/${EXPERIMENT_NAME:-LLaMEA_single}"
    BEST_OPERATOR="$EXP_DIR/llamea_best_operator.py"
    if [ -f "$BEST_OPERATOR" ]; then
        echo "Comparando el mejor operador contra los clasicos ..."
        COMPARE_ARGS=(
            --operator "llamea=$BEST_OPERATOR"
            --operator ox=classic:ox
            --operator pbx=classic:pbx
            --operator pmx=classic:pmx
            --operator cx=classic:cx
            --operator erx=classic:erx
            --operator ox2=classic2:ox
            --operator pbx2=classic2:pbx
            --operator pmx2=classic2:pmx
            --operator cx2=classic2:cx
            --operator erx2=classic2:erx
            --fail-policy "${COMPARE_FAIL_POLICY:-zero}"
            --split "${COMPARE_SPLIT:-test}"
            --repeats "${COMPARE_REPEATS:-11}"
            --name "${COMPARE_NAME:-${EXPERIMENT_NAME:-LLaMEA_single}_vs_clasicos}"
            --save-fronts
        )
        if [ "${COMPARE_GE_PROTOCOL:-0}" = "1" ]; then
            # Protocolo GE completo: 3 solvers x 2 mutaciones x 300/105.
            # Es caro; usar solo para la tabla final de publicacion.
            COMPARE_ARGS+=(--ge-protocol)
        else
            COMPARE_ARGS+=(--solver "${COMPARE_SOLVERS:-${SOLVER:-MOEAD}}")
            if [ "${COMPARE_MUTATION:-0}" = "1" ]; then
                COMPARE_ARGS+=(--mutation)
            fi
            if [ "${COMPARE_MUTATION_BOTH:-0}" = "1" ]; then
                COMPARE_ARGS+=(--mutation-both)
            fi
            if [ -n "${COMPARE_MO_GENERATIONS:-}" ]; then
                COMPARE_ARGS+=(--mo-generations "${COMPARE_MO_GENERATIONS}")
            fi
            if [ -n "${COMPARE_MO_POPULATION_SIZE:-}" ]; then
                COMPARE_ARGS+=(--mo-population-size "${COMPARE_MO_POPULATION_SIZE}")
            fi
        fi
        python scripts/compare_operators.py "${COMPARE_ARGS[@]}"
    else
        echo "AVISO: no existe $BEST_OPERATOR; se omite COMPARE=1." >&2
    fi
fi

echo "Fin del job unico."
